{
	admin off
	persist_config off
	http_port 8080
	https_port 8443
	# IP-address clients normally omit TLS SNI.
	default_sni {$DASHBOARD_PUBLIC_HOST}
	servers {
		protocols h1 h2
	}
}

{$DASHBOARD_PUBLIC_HOST} {
	# Explicit public issuer: IP addresses otherwise use an internal CA.
	tls {
		issuer acme {
			dir https://acme-v02.api.letsencrypt.org/directory
			profile shortlived
		}
	}
	# Access logging stays disabled: invitation URLs may carry credentials.
	reverse_proxy dashboard:6060 {
		# Authorization uses the configured public origin, never proxy headers.
		header_up -Forwarded
		header_up -X-Forwarded-*
	}
}
