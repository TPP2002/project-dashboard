# Deny by default: no repository history, worktrees, private documents or data.
**
!Dockerfile
!.dockerignore
!package.json
!core/
!core/**/
!core/**/*.cjs
!core/**/*.mjs
!server/
!server/**/
!server/**/*.cjs
!cli/
!cli/**/
!cli/**/*.cjs
!packages/
!packages/owner-node/
!packages/owner-node/*.cjs
!packages/scheduler/
!packages/scheduler/package.json
!packages/scheduler/package-lock.json
!packages/scheduler/build.cjs
!packages/scheduler/src/
!packages/scheduler/src/**
!docs/
!docs/self-hosting.md
!web/
!web/package.json
!web/package-lock.json
!web/index.html
!web/env.d.ts
!web/vite.config.ts
!web/tsconfig*.json
!web/src/
!web/src/**
!web/mock/
!web/mock/**
!web/public/
!web/public/**

# These exclusions win even inside an allowed source directory.
**/.git
**/.git/**
**/.codex
**/.codex/**
**/.claude
**/.claude/**
**/.dashboard
**/.dashboard/**
**/.env
**/.env.*
**/node_modules
**/node_modules/**
**/dist
**/dist/**
**/data
**/data/**
**/private
**/private/**
**/secrets
**/secrets/**
**/backups
**/backups/**
**/registry.json
**/board.json
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.tar
**/*.tar.gz
**/*.zip
