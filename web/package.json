{
  "name": "claude-dashboard-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "多项目管理看板前端（Vite + Vue3 + Pinia + vue-router + echarts）。依赖仅装本目录 node_modules，绝不污染被监控项目。",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "node ../cli/scheduledWork.cjs build",
    "preview": "vite preview",
    "typecheck": "node ../cli/scheduledWork.cjs typecheck",
    "icons": "node scripts/sync-icons.cjs",
    "check:no-emoji": "node scripts/check-no-emoji.cjs"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "mammoth": "^1.12.3",
    "marked": "^15.0.12",
    "pdfjs-dist": "^6.3.289",
    "pinia": "^2.2.6",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vue": "^3.5.13",
    "vue-echarts": "^7.0.3",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}
