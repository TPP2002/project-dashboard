# Non-secret defaults only. Copy to .env locally; never commit .env or data.
COMPOSE_PROJECT_NAME=dashboard
NODE_IMAGE=node:24-bookworm-slim
DASHBOARD_IMAGE=dashboard-selfhost:local
# Set to the reviewed source commit when building a release.
DASHBOARD_REVISION=unknown
# Pre-create this directory; its container-visible owner must be UID/GID 1000.
DASHBOARD_DATA_DIR=./data
DASHBOARD_BIND_PORT=6060
# Loopback HTTP is for local/SSH-tunnel verification only.
# Before remote use, set the exact browser-facing HTTPS origin (no path).
DASHBOARD_PUBLIC_ORIGIN=http://127.0.0.1:6060
# Passwords/tokens belong in protected secret files, never in this file.
# Optional compose.scheduler.yaml requires these prepared, separate directories.
# SCHEDULER_DATA_DIR=/srv/dashboard/scheduler-data
# SCHEDULER_CONFIG_DIR=/srv/dashboard/scheduler-config
# Optional compose.owner-node.yaml connects the owner's Windows nodes.
# OWNER_NODE_CONFIG_DIR=/srv/dashboard/owner-node-config
# Optional compose.https.yaml. Configure only after private validation.
# DASHBOARD_PUBLIC_HOST=YOUR_PUBLIC_IP_OR_HOSTNAME
# CADDY_IMAGE=dashboard-caddy:2.11.7
# CADDY_BASE_IMAGE=caddy:2.11.7-alpine
# CADDY_DATA_DIR=/srv/dashboard/caddy-data
# Set DASHBOARD_PUBLIC_ORIGIN above to https://YOUR_PUBLIC_IP_OR_HOSTNAME.
